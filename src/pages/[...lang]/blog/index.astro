---
import Layout from "../../../layouts/Layout.astro"
import PageHeader from "../../../components/PageHeader.astro"
import PostCard from "../../../components/PostCard.astro"
import { getPage, getPosts, postPath } from "../../../lib/content"
import { breadcrumbs } from "../../../lib/schema"
import { getLocale, localePaths, localizedPath, useUI } from "../../../i18n/utils"
import { localeMeta } from "../../../i18n/ui"
import { SITE } from "../../../consts"

export const getStaticPaths = () => localePaths()

const locale = getLocale(Astro)
const t = useUI(locale)
const { data } = await getPage("blog", locale)
const posts = await getPosts(locale)
const site = Astro.site!
const blogUrl = new URL(localizedPath("/blog", locale), site).href
---

<Layout
  title={data.title}
  description={data.description}
  image={posts[0]?.data.cover}
  imageAlt={posts[0]?.data.coverAlt}
  noindex={posts.length === 0}
  schema={[
    {
      "@type": "Blog",
      "@id": `${blogUrl}#blog`,
      url: blogUrl,
      name: t.blog.rssTitle,
      description: data.description,
      inLanguage: localeMeta[locale].hreflang,
      author: { "@id": new URL("/#person", site).href },
      blogPost: posts.map((post) => ({
        "@type": "BlogPosting",
        headline: post.data.title,
        description: post.data.description,
        url: new URL(postPath(post, locale), site).href,
        datePublished: post.data.pubDate.toISOString(),
        dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
        author: { "@id": new URL("/#person", site).href },
      })),
    },
    breadcrumbs(site, [
      { name: t.nav.home, path: localizedPath("/", locale) },
      { name: data.heading ?? data.title, path: localizedPath("/blog", locale) },
    ]),
  ]}
>
  <div class="container-page pt-8 sm:pt-12 lg:pt-16">
    <PageHeader title={data.heading ?? data.title} subtitle={data.subheading} />
    {
      posts.length > 0 ? (
        <ul class="flex max-w-3xl flex-col gap-10 sm:gap-12">
          {posts.map((post, i) => (
            <li>
              <PostCard post={post} eager={i < 2} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="rounded-xl border border-dashed border-gray-300 p-8 text-center text-gray-500">
          {t.blog.empty}
        </p>
      )
    }
  </div>
</Layout>
