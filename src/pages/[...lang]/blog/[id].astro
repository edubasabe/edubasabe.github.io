---
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import { render } from "astro:content"
import Layout from "../../../layouts/Layout.astro"
import ShareBar from "../../../components/ShareBar.astro"
import Avatar from "../../../components/Avatar.astro"
import {
  formatDate,
  getPage,
  getPostAlternates,
  getPosts,
  postPath,
  postSlug,
  readingTime,
} from "../../../lib/content"
import { breadcrumbs } from "../../../lib/schema"
import { localeMeta, locales } from "../../../i18n/ui"
import { getLocale, localizedPath, useUI } from "../../../i18n/utils"
import { SITE } from "../../../consts"

export async function getStaticPaths() {
  const paths = []
  for (const locale of locales) {
    for (const post of await getPosts(locale)) {
      paths.push({
        params: { lang: locale === "en" ? undefined : locale, id: postSlug(post) },
        props: { post },
      })
    }
  }
  return paths
}

const { post } = Astro.props
const { data } = post
const locale = getLocale(Astro)
const t = useUI(locale)
const { Content } = await render(post)
const { words, minutes } = readingTime(post)
const blogTitle = (await getPage("blog", locale)).data.title

const site = Astro.site!
const url = new URL(postPath(post, locale), site).href
const personId = new URL("/#person", site).href
const modified = data.updatedDate ?? data.pubDate
const alternates = await getPostAlternates(post)
---

<Layout
  title={data.title}
  description={data.description}
  image={data.cover}
  imageAlt={data.coverAlt}
  type="article"
  noindex={data.draft}
  alternates={alternates}
  switchFallback="/blog"
  article={{ publishedTime: data.pubDate, modifiedTime: data.updatedDate, tags: data.tags }}
  schema={[
    {
      "@type": "BlogPosting",
      "@id": `${url}#article`,
      mainEntityOfPage: { "@id": `${url}#webpage` },
      isPartOf: { "@id": `${new URL(localizedPath("/blog", locale), site).href}#blog` },
      headline: data.title,
      description: data.description,
      image: [new URL(data.cover.src, site).href],
      datePublished: data.pubDate.toISOString(),
      dateModified: modified.toISOString(),
      author: { "@id": personId },
      publisher: { "@id": personId },
      keywords: data.tags,
      articleSection: data.tags[0],
      wordCount: words,
      timeRequired: `PT${minutes}M`,
      inLanguage: localeMeta[locale].hreflang,
    },
    breadcrumbs(site, [
      { name: t.nav.home, path: localizedPath("/", locale) },
      { name: blogTitle, path: localizedPath("/blog", locale) },
      { name: data.title, path: postPath(post, locale) },
    ]),
  ]}
>
  <article class="container-page pt-6 sm:pt-10 lg:pt-14">
    <div class="mx-auto max-w-2xl">
      <nav aria-label={t.blog.breadcrumb} class="mb-6 text-sm text-gray-500 sm:mb-8">
        <ol class="flex min-w-0 items-center gap-1.5">
          <li><a href={localizedPath("/", locale)} class="hover:text-gray-900">{t.nav.home}</a></li>
          <li aria-hidden="true"><Icon name="mdi:chevron-right" class="size-4" /></li>
          <li><a href={localizedPath("/blog", locale)} class="hover:text-gray-900">{blogTitle}</a></li>
          <li aria-hidden="true"><Icon name="mdi:chevron-right" class="size-4" /></li>
          <li class="truncate text-gray-900" aria-current="page">{data.title}</li>
        </ol>
      </nav>

      {
        data.draft && (
          <p class="mb-6 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-800">
            {t.blog.draftNotice}
          </p>
        )
      }

      <header>
        <h1 class="text-3xl font-bold tracking-tight text-balance text-gray-900 sm:text-4xl">
          {data.title}
        </h1>
        <p class="mt-3 text-lg text-pretty text-gray-600 sm:text-xl">{data.description}</p>

        <div class="mt-6 flex items-center gap-3">
          <a
            href={localizedPath("/about", locale)}
            class="shrink-0"
            aria-label={t.blog.aboutLink(SITE.author)}
          >
            <Avatar size={44} />
          </a>
          <div class="min-w-0">
            <a href={localizedPath("/about", locale)} rel="author" class="font-semibold text-gray-900 hover:underline">
              {SITE.author}
            </a>
            <p class="flex flex-wrap items-center gap-x-2 text-sm text-gray-500">
              <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, locale)}</time>
              <span aria-hidden="true">·</span>
              <span>{t.blog.minRead(minutes)}</span>
              {
                data.updatedDate && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>
                      {t.blog.updated} <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate, locale)}</time>
                    </span>
                  </>
                )
              }
            </p>
          </div>
        </div>
      </header>
    </div>

    <figure class="mx-auto mt-8 max-w-3xl sm:mt-10">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 768px) 768px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-video w-full rounded-2xl object-cover"
      />
    </figure>

    <div class="mx-auto mt-8 max-w-2xl sm:mt-10">
      <div class="prose-content prose-article">
        <Content />
      </div>

      {
        data.tags.length > 0 && (
          <ul class="mt-10 flex flex-wrap gap-2" aria-label={t.blog.tags}>
            {data.tags.map((tag) => (
              <li class="rounded-full bg-gray-100 px-3 py-1.5 text-sm text-gray-700">{tag}</li>
            ))}
          </ul>
        )
      }

      <aside class="mt-12 flex gap-4 rounded-2xl border border-gray-200 p-5 sm:p-6" aria-label={t.blog.aboutAuthor}>
        <Avatar size={48} />
        <div>
          <p class="font-semibold text-gray-900">{SITE.author}</p>
          <p class="mt-1 text-sm text-gray-600">{t.blog.authorBlurb}</p>
          <a href={localizedPath("/about", locale)} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-blue-600 hover:underline">
            {t.blog.moreAboutMe} <Icon name="mdi:chevron-right" class="size-4" aria-hidden="true" />
          </a>
        </div>
      </aside>

      <a href={localizedPath("/blog", locale)} class="mt-10 inline-flex min-h-11 items-center gap-1 text-sm font-medium text-gray-600 hover:text-gray-900">
        <Icon name="mdi:arrow-left" class="size-4" aria-hidden="true" /> {t.blog.allPosts}
      </a>
    </div>
  </article>

  <ShareBar url={url} title={data.title} />
</Layout>
