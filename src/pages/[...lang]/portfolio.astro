---
import Layout from "../../layouts/Layout.astro"
import ProjectList from "../../components/ProjectList.astro"
import PageHeader from "../../components/PageHeader.astro"
import { breadcrumbs } from "../../lib/schema"
import { getPage, getProjects } from "../../lib/content"
import { getLocale, localePaths, localizedPath, useUI } from "../../i18n/utils"

export const getStaticPaths = () => localePaths()

const locale = getLocale(Astro)
const t = useUI(locale)
const { data } = await getPage("portfolio", locale)
const projects = await getProjects()
const pageUrl = new URL(localizedPath("/portfolio", locale), Astro.site).href
---

<Layout
  title={data.title}
  description={data.description}
  image={projects[0]?.data.cover}
  imageAlt={projects[0]?.data.coverAlt[locale]}
  schema={[
    {
      "@type": "CollectionPage",
      "@id": `${pageUrl}#collection`,
      url: pageUrl,
      name: data.title,
      description: data.description,
      mainEntity: {
        "@type": "ItemList",
        numberOfItems: projects.length,
        itemListElement: projects.map(({ data: p }, i) => ({
          "@type": "ListItem",
          position: i + 1,
          item: {
            "@type": "WebSite",
            name: p.name,
            url: p.url,
            creator: { "@id": new URL("/#person", Astro.site).href },
          },
        })),
      },
    },
    breadcrumbs(Astro.site!, [
      { name: t.nav.home, path: localizedPath("/", locale) },
      { name: t.nav.portfolio, path: localizedPath("/portfolio", locale) },
    ]),
  ]}
>
  <div class="container-page pt-8 sm:pt-12 lg:pt-16">
    <PageHeader title={data.heading ?? data.title} subtitle={data.subheading} />
    <ProjectList projects={projects} />
  </div>
</Layout>
