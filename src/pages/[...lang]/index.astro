---
import { Image } from "astro:assets"
import Layout from "../../layouts/Layout.astro"
import Cover from "../../assets/images/cover.jpg"
import Hero from "../../components/Hero.astro"
import { getPage } from "../../lib/content"
import { getLocale, localePaths, useUI } from "../../i18n/utils"

export const getStaticPaths = () => localePaths()

const locale = getLocale(Astro)
const t = useUI(locale)
const { data } = await getPage("home", locale)
---

<Layout title={data.title} description={data.description} class="flex">
  <section
    class="container-page grid content-center gap-10 py-10 sm:py-16 lg:grid-cols-2 lg:items-center lg:gap-16 lg:py-20"
  >
    <Hero title={data.heading ?? ""} words={data.words ?? []} intro={data.subheading} />
    <Image
      src={Cover}
      alt={t.home.imageAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 480px, (min-width: 640px) calc(100vw - 4rem), calc(100vw - 2.5rem)"
      class="aspect-4/3 w-full rounded-2xl object-cover sm:aspect-video lg:aspect-square"
      loading="eager"
      fetchpriority="high"
    />
  </section>
</Layout>
