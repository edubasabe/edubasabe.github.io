---
import { render } from "astro:content"
import Layout from "../layouts/Layout.astro"
import { getPage } from "../lib/content"
import { SITE } from "../consts"
import PageHeader from "../components/PageHeader.astro"

const page = await getPage("about")
const { data } = page
const { Content } = await render(page)
---

<Layout
  title={data.title}
  description={data.description}
  type="profile"
  schema={[
    {
      "@type": "ProfilePage",
      "@id": new URL("/about#profile", Astro.site).href,
      url: new URL("/about", Astro.site).href,
      mainEntity: { "@id": new URL("/#person", Astro.site).href },
      name: `About ${SITE.author}`,
    },
  ]}
>
  <div class="container-page pt-8 sm:pt-12 lg:pt-16">
   <div class="mx-auto max-w-2xl">
    <PageHeader title={data.heading ?? data.title} subtitle={data.subheading} />

    <article class="prose-content">
      <Content />
    </article>

    {
      data.techStack && (
        <section aria-labelledby="tech-stack" class="mt-10">
          <h2 id="tech-stack" class="mb-4 text-lg font-semibold tracking-tight sm:text-xl">
            💻 Tech stack
          </h2>
          <ul class="flex flex-wrap gap-2">
            {data.techStack.map((tech) => (
              <li class="rounded-full border border-gray-200 px-3 py-1 text-sm text-gray-700">
                {tech}
              </li>
            ))}
          </ul>
        </section>
      )
    }
   </div>
  </div>
</Layout>
