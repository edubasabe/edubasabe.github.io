---
import { render } from "astro:content"
import Layout from "../layouts/Layout.astro"
import { getPage } from "../lib/content"
import { SITE } from "../consts"

const page = await getPage("about")
const { data } = page
const { Content } = await render(page)
---

<Layout
  title={data.title}
  description={data.description}
  type="profile"
  class="md:min-h-screen"
  schema={[
    {
      "@type": "ProfilePage",
      "@id": new URL("/about#profile", Astro.site).href,
      url: new URL("/about", Astro.site).href,
      mainEntity: { "@id": new URL("/#person", Astro.site).href },
      name: `About ${SITE.author}`,
    },
  ]}
>
  <main id="main" class="mx-auto max-w-3xl px-4 pt-6 md:px-0">
    <h1 class="text-2xl font-semibold">{data.heading}</h1>
    <p class="mb-4 font-semibold">{data.subheading}</p>

    <article class="prose-content">
      <Content />
    </article>

    {
      data.techStack && (
        <section aria-labelledby="tech-stack">
          <h2 id="tech-stack" class="mb-2 flex items-center gap-x-2 text-xl font-bold">
            <span aria-hidden="true">💻</span> Tech Stack
          </h2>
          <ul class="mb-4 flex flex-wrap gap-x-4 gap-y-1">
            {data.techStack.map((tech) => <li>{tech}</li>)}
          </ul>
        </section>
      )
    }
  </main>
</Layout>
