---
interface Props {
  title: string
  words: string[]
}

const { title, words } = Astro.props
---

<div class="mb-4 flex flex-2 shrink-0 items-center px-4 xl:px-14">
  <h1
    class="bg-linear-to-r from-slate-800/80 to-slate-900 to-50% bg-clip-text text-5xl font-extrabold tracking-tight text-balance text-transparent md:text-7xl"
  >
    {title}&nbsp;<span class="sr-only">{words.join(", ")}</span><span
      aria-hidden="true"
      class="inline-flex h-[calc(var(--text-5xl)*var(--leading-tight))] flex-col overflow-hidden text-blue-500 md:h-[calc(var(--text-7xl)*var(--leading-tight))]"
    >
      <span class="animate-text-slide-5 block text-left leading-tight">
        {words.map((word) => <span class="block tracking-tight">{word}</span>)}
        <span class="block tracking-tight">{words[0]}</span>
      </span>
    </span>
  </h1>
</div>
