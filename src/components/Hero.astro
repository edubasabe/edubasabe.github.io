---
import { getLocale, localizedPath, useUI } from "../i18n/utils"

interface Props {
  title: string
  words: string[]
  intro?: string
}

const { title, words, intro } = Astro.props
const locale = getLocale(Astro)
const t = useUI(locale)
---

<div>
  <h1
    class="text-[clamp(2.5rem,11vw,4.5rem)] leading-[1.08] font-extrabold tracking-tight text-gray-900"
  >
    <span class="block text-balance">{title}</span>
    <span class="sr-only">{words.join(", ")}</span>
    <span aria-hidden="true" class="block h-[1lh] overflow-hidden text-blue-600">
      <span class="animate-text-slide-5 block">
        {words.map((word) => <span class="block h-[1lh]">{word}</span>)}
        <span class="block h-[1lh]">{words[0]}</span>
      </span>
    </span>
  </h1>
  {intro && <p class="mt-5 max-w-md text-base text-pretty text-gray-500 sm:text-lg">{intro}</p>}
  <div class="mt-8 flex flex-col gap-3 sm:flex-row">
    <a href={localizedPath("/contact", locale)} class="btn-primary">{t.hero.contact}</a>
    <a href={localizedPath("/portfolio", locale)} class="btn-secondary">{t.hero.work}</a>
  </div>
</div>
