---
import { Image } from "astro:assets"
import Logo from "../assets/logo-ebasabe.svg"
import { cleanPath } from "../lib/content"

interface Props {
  links: {
    label: string
    href: string
  }[]
}

const { links } = Astro.props
const current = cleanPath(Astro.url.pathname)
---

<nav
  aria-label="Main"
  class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 md:space-x-10 md:px-0"
>
  <a href="/" class="relative py-3 text-2xl font-semibold text-gray-800">
    <span class="sr-only">ebasabe — home</span>
    <Image src={Logo} alt="" class="h-6 w-auto md:h-5" loading="eager" />
  </a>
  <ul class="flex items-center gap-x-4 text-sm">
    {
      links.map(({ href, label }) => (
        <li class="hidden md:block">
          <a
            href={href}
            aria-current={current === href ? "page" : undefined}
            class="rounded-md px-3 py-2 font-medium text-gray-600 hover:bg-blue-300/10 hover:text-blue-950 aria-[current=page]:text-blue-950"
          >
            {label}
          </a>
        </li>
      ))
    }
    <li>
      <a
        href="/contact"
        class="block rounded-md bg-linear-to-tr from-blue-500 to-blue-600 px-4 py-1.5 leading-6 font-semibold tracking-wide text-white shadow-lg shadow-blue-500/40 md:ml-5"
        >Contact</a
      >
    </li>
  </ul>
</nav>
