---
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import Logo from "../assets/logo-ebasabe.svg"
import { cleanPath, getLocale, localizedPath, useUI } from "../i18n/utils"

interface Props {
  links: {
    label: string
    href: string
  }[]
}

const { links } = Astro.props
const locale = getLocale(Astro)
const t = useUI(locale)
const current = cleanPath(Astro.url.pathname)
// Sections stay highlighted on their sub-pages (e.g. /blog/my-post highlights Blog)
const isCurrent = (href: string, section = false) =>
  current === href || (section && current.startsWith(`${href}/`)) ? "page" : undefined
const home = localizedPath("/", locale)
const contact = localizedPath("/contact", locale)
---

<nav aria-label={t.nav.label} class="container-page flex h-14 items-center justify-between sm:h-16">
  <a href={home} class="-ml-2 flex min-h-11 items-center px-2">
    <span class="sr-only">{t.nav.logo}</span>
    <Image src={Logo} alt="" class="site-logo h-5 w-auto" loading="eager" />
  </a>

  <!-- Tablet & desktop -->
  <ul class="hidden items-center gap-1 text-sm sm:flex">
    {
      links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={isCurrent(href, true)}
            class="rounded-md px-3 py-2 font-medium text-gray-600 transition-colors hover:text-gray-900 aria-[current=page]:text-gray-900"
          >
            {label}
          </a>
        </li>
      ))
    }
    <li class="ml-2">
      <a
        href={contact}
        class="inline-flex h-9 items-center rounded-lg bg-blue-600 px-4 font-semibold text-white shadow-sm shadow-blue-600/20 transition-colors hover:bg-blue-700"
        >{t.nav.contact}</a
      >
    </li>
  </ul>

  <div class="flex items-center gap-1 sm:ml-2">
  <button type="button" data-theme-toggle aria-label={t.nav.darkMode} aria-pressed="false" class="grid size-11 place-items-center rounded-lg text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900">
    <Icon name="lucide:moon" class="theme-moon size-5" aria-hidden="true" />
    <Icon name="lucide:sun" class="theme-sun size-5" aria-hidden="true" />
  </button>

  <!-- Mobile -->
  <button
    type="button"
    popovertarget="mobile-menu"
    class="-mr-2 grid size-11 place-items-center rounded-lg text-gray-900 sm:hidden"
    aria-label={t.nav.openMenu}
  >
    <Icon name="mdi:menu" class="size-6" aria-hidden="true" />
  </button>

  </div>

  <div
    id="mobile-menu"
    popover
    class="inset-x-0 top-0 bottom-auto m-0 w-full max-w-none border-0 border-b border-gray-100 bg-white p-0 pt-[env(safe-area-inset-top)] shadow-xl sm:hidden"
  >
    <div class="container-page flex h-14 items-center justify-between">
      <a href={home} class="-ml-2 flex min-h-11 items-center px-2">
        <span class="sr-only">{t.nav.logo}</span>
        <Image src={Logo} alt="" class="site-logo h-5 w-auto" />
      </a>
      <button
        type="button"
        popovertarget="mobile-menu"
        popovertargetaction="hide"
        class="-mr-2 grid size-11 place-items-center rounded-lg text-gray-900"
        aria-label={t.nav.closeMenu}
      >
        <Icon name="mdi:close" class="size-6" aria-hidden="true" />
      </button>
    </div>
    <ul class="container-page flex flex-col pt-2 pb-6">
      {
        [{ href: home, label: t.nav.home }, ...links].map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrent(href, href !== home)}
              class="flex min-h-12 items-center text-2xl font-semibold tracking-tight text-gray-500 aria-[current=page]:text-gray-900"
            >
              {label}
            </a>
          </li>
        ))
      }
      <li class="mt-4">
        <a href={contact} class="btn-primary w-full">{t.nav.contact}</a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const root = document.documentElement
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]")
  const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
  let preference: string | null = null
  try { preference = localStorage.getItem("theme") } catch {}

  function applyTheme(dark: boolean) {
    root.classList.toggle("dark", dark)
    toggle?.setAttribute("aria-pressed", String(dark))
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#111827" : "#ffffff")
  }

  applyTheme(root.classList.contains("dark"))
  toggle?.addEventListener("click", () => {
    const dark = !root.classList.contains("dark")
    preference = dark ? "dark" : "light"
    try { localStorage.setItem("theme", preference) } catch {}
    applyTheme(dark)
  })
  systemTheme.addEventListener("change", (event) => {
    if (preference !== "light" && preference !== "dark") applyTheme(event.matches)
  })
</script>
