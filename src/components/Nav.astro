---
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import Logo from "../assets/logo-ebasabe.svg"
import { cleanPath } from "../lib/content"

interface Props {
  links: {
    label: string
    href: string
  }[]
}

const { links } = Astro.props
const current = cleanPath(Astro.url.pathname)
const isCurrent = (href: string) => (current === href ? "page" : undefined)
---

<nav aria-label="Main" class="container-page flex h-14 items-center justify-between sm:h-16">
  <a href="/" class="-ml-2 flex min-h-11 items-center px-2">
    <span class="sr-only">ebasabe — home</span>
    <Image src={Logo} alt="" class="h-5 w-auto" loading="eager" />
  </a>

  <!-- Tablet & desktop -->
  <ul class="hidden items-center gap-1 text-sm sm:flex">
    {
      links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={isCurrent(href)}
            class="rounded-md px-3 py-2 font-medium text-gray-600 transition-colors hover:text-gray-900 aria-[current=page]:text-gray-900"
          >
            {label}
          </a>
        </li>
      ))
    }
    <li class="ml-3">
      <a
        href="/contact"
        class="inline-flex h-9 items-center rounded-lg bg-blue-600 px-4 font-semibold text-white shadow-sm shadow-blue-600/20 transition-colors hover:bg-blue-700"
        >Contact</a
      >
    </li>
  </ul>

  <!-- Mobile -->
  <button
    type="button"
    popovertarget="mobile-menu"
    class="-mr-2 grid size-11 place-items-center rounded-lg text-gray-900 sm:hidden"
    aria-label="Open menu"
  >
    <Icon name="mdi:menu" class="size-6" aria-hidden="true" />
  </button>

  <div
    id="mobile-menu"
    popover
    class="inset-x-0 top-0 bottom-auto m-0 w-full max-w-none border-0 border-b border-gray-100 bg-white p-0 pt-[env(safe-area-inset-top)] shadow-xl sm:hidden"
  >
    <div class="container-page flex h-14 items-center justify-between">
      <a href="/" class="-ml-2 flex min-h-11 items-center px-2">
        <span class="sr-only">ebasabe — home</span>
        <Image src={Logo} alt="" class="h-5 w-auto" />
      </a>
      <button
        type="button"
        popovertarget="mobile-menu"
        popovertargetaction="hide"
        class="-mr-2 grid size-11 place-items-center rounded-lg text-gray-900"
        aria-label="Close menu"
      >
        <Icon name="mdi:close" class="size-6" aria-hidden="true" />
      </button>
    </div>
    <ul class="container-page flex flex-col pt-2 pb-6">
      {
        [{ href: "/", label: "Home" }, ...links].map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrent(href)}
              class="flex min-h-12 items-center text-2xl font-semibold tracking-tight text-gray-400 aria-[current=page]:text-gray-900"
            >
              {label}
            </a>
          </li>
        ))
      }
      <li class="mt-4">
        <a href="/contact" class="btn-primary w-full">Contact</a>
      </li>
    </ul>
  </div>
</nav>
