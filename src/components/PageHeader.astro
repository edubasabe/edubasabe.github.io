---
interface Props {
  title: string
  subtitle?: string
}

const { title, subtitle } = Astro.props
---

<div class="mb-8 sm:mb-12">
  <h1 class="text-3xl font-bold tracking-tight text-balance text-gray-900 sm:text-4xl">
    {title}
  </h1>
  {
    subtitle && (
      <p class="mt-2 text-base text-pretty text-gray-500 sm:mt-3 sm:text-lg">{subtitle}</p>
    )
  }
</div>
