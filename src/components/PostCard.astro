---
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import type { CollectionEntry } from "astro:content"
import { formatDate, readingTime } from "../lib/content"

interface Props {
  post: CollectionEntry<"blog">
  eager?: boolean
}

const { post, eager = false } = Astro.props
const { data } = post
const { minutes } = readingTime(post)
---

<article class="group relative flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-5">
  <div class="shrink-0 overflow-hidden rounded-xl bg-gray-50 sm:w-48 lg:w-56">
    <Image
      src={data.cover}
      alt={data.coverAlt}
      widths={[400, 800]}
      sizes="(min-width: 1024px) 224px, (min-width: 640px) 192px, 100vw"
      loading={eager ? "eager" : "lazy"}
      class="aspect-video w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 motion-reduce:transition-none sm:aspect-4/3"
    />
  </div>
  <div class="min-w-0 grow">
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm whitespace-nowrap text-gray-500">
      <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
      {data.draft && <span class="rounded bg-amber-100 px-1.5 text-xs font-medium text-amber-800">Draft</span>}
    </p>
    <h2 class="mt-2 text-xl font-semibold tracking-tight text-pretty text-gray-900 group-hover:text-gray-600">
      <a href={`/blog/${post.id}`} class="after:absolute after:inset-0">{data.title}</a>
    </h2>
    <p class="mt-2 line-clamp-2 text-pretty text-gray-600">{data.description}</p>
    <p class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-blue-600 group-hover:underline" aria-hidden="true">
      Read more
      <Icon name="mdi:chevron-right" class="size-4" />
    </p>
  </div>
</article>
