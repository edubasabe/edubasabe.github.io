---
import { Icon } from "astro-icon/components"
import { SITE } from "../consts"
import { getLocale, useUI } from "../i18n/utils"

interface Props {
  languages: { locale: string; label: string; short: string; href: string; current: boolean }[]
}

const { languages } = Astro.props
const t = useUI(getLocale(Astro))
---

<footer class="mt-16 border-t border-gray-100 sm:mt-24">
  <div
    class="container-page flex flex-col-reverse items-center gap-4 pt-6 pb-[max(1.5rem,env(safe-area-inset-bottom))] sm:flex-row sm:justify-between"
  >
    <p class="text-sm text-gray-500">
      © {new Date().getFullYear()} {SITE.author}
    </p>

    <div class="flex flex-col items-center gap-3 sm:flex-row sm:gap-5">
      <!-- Language toggle -->
      <nav aria-label={t.nav.language} class="flex items-center gap-2">
        <Icon name="lucide:languages" class="size-5 text-gray-500" aria-hidden="true" />
        <ul class="flex rounded-full bg-gray-100 p-0.5 text-sm font-medium">
          {
            languages.map((l) => (
              <li>
                {l.current ? (
                  <span
                    lang={l.locale}
                    aria-current="true"
                    title={l.label}
                    class="inline-flex h-11 min-w-12 items-center justify-center rounded-full bg-white px-3 text-gray-900 shadow-sm"
                  >
                    <span aria-hidden="true">{l.short}</span>
                    <span class="sr-only">{l.label}</span>
                  </span>
                ) : (
                  <a
                    href={l.href}
                    lang={l.locale}
                    hreflang={l.locale}
                    title={l.label}
                    class="inline-flex h-11 min-w-12 items-center justify-center rounded-full px-3 text-gray-600 transition-colors hover:text-gray-900"
                  >
                    <span aria-hidden="true">{l.short}</span>
                    <span class="sr-only">{l.label}</span>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="-mx-2 flex items-center gap-1" aria-label={t.footer.social}>
        {
          SITE.social.map(({ label, icon, href }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="me noopener noreferrer"
                aria-label={label}
                title={label}
                class="grid size-11 place-items-center rounded-lg text-gray-500 transition-colors hover:text-gray-900"
              >
                <Icon name={icon} class="size-5" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
