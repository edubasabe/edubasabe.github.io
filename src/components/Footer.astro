---
import { Icon } from "astro-icon/components"
import { SITE } from "../consts"
---

<footer class="my-2 w-full p-4">
  <div
    class="mx-auto flex max-w-6xl flex-col-reverse items-center justify-between md:flex-row"
  >
    <p class="py-4 text-xs font-medium text-gray-700">
      © {new Date().getFullYear()} {SITE.name}. All rights reserved
    </p>
    <div class="flex w-full flex-col gap-y-2 md:w-auto">
      <h2 class="text-sm font-semibold text-gray-700">Follow me</h2>
      <ul class="flex items-center justify-between gap-x-6 md:justify-start">
        {
          SITE.social.map(({ label, icon, href }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="me noopener noreferrer"
                class="flex items-center gap-x-2 text-sm font-medium"
              >
                <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
