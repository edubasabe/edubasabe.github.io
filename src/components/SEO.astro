---
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"
import DefaultOgImage from "../assets/images/cover.jpg"
import { SITE } from "../consts"
import { defaultLocale, localeMeta, locales, type Locale } from "../i18n/ui"
import { cleanPath, localizedPath, useUI, type Alternates } from "../i18n/utils"

export interface Props {
  title: string
  description: string
  locale: Locale
  /** The same page in each language that exists (used for hreflang) */
  alternates: Alternates
  image?: ImageMetadata
  imageAlt?: string
  type?: "website" | "profile" | "article"
  /** Open Graph article metadata (when type is "article") */
  article?: {
    publishedTime: Date
    modifiedTime?: Date
    tags?: string[]
  }
  noindex?: boolean
  /** Extra JSON-LD nodes merged into the page @graph */
  schema?: Record<string, unknown>[]
}

const {
  title,
  description,
  locale,
  alternates,
  image = DefaultOgImage,
  imageAlt,
  type = "website",
  article,
  noindex = false,
  schema = [],
} = Astro.props

const site = Astro.site ?? new URL(SITE.url)
const t = useUI(locale)
const lang = localeMeta[locale].hreflang
const abs = (path: string) => new URL(path, site).href
const alternateEntries = locales.filter((l) => alternates[l]).map((l) => [l, abs(alternates[l]!)] as const)
const xDefault = (alternateEntries.find(([l]) => l === defaultLocale) ?? alternateEntries[0])?.[1]
const canonical = new URL(cleanPath(Astro.url.pathname), site).href
const fullTitle = title.includes(SITE.author) ? title : `${title} | ${SITE.author}`

const ogAlt = imageAlt ?? `${SITE.author} — ${t.jobTitle}`
const og = await getImage({ src: image, width: 1200, height: 630, format: "jpg" })
const ogImage = new URL(og.src, site).href

const personId = `${site.href}#person`
const websiteId = `${abs(localizedPath("/", locale))}#website`

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: SITE.author,
      alternateName: SITE.handle,
      url: site.href,
      jobTitle: t.jobTitle,
      email: `mailto:${SITE.email}`,
      nationality: { "@type": "Country", name: SITE.country },
      knowsAbout: SITE.knowsAbout,
      sameAs: [...SITE.social.map((s) => s.href), SITE.twitter],
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: site.href,
      name: t.siteName,
      alternateName: SITE.name,
      inLanguage: lang,
      author: { "@id": personId },
      publisher: { "@id": personId },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: fullTitle,
      description,
      inLanguage: lang,
      isPartOf: { "@id": websiteId },
      about: { "@id": personId },
      primaryImageOfPage: { "@type": "ImageObject", url: ogImage },
    },
    ...schema,
  ],
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  alternateEntries.length > 1 && (
    <>
      {alternateEntries.map(([l, href]) => (
        <link rel="alternate" hreflang={localeMeta[l].hreflang} href={href} />
      ))}
      {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    </>
  )
}
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
<meta name="author" content={SITE.author} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={localeMeta[locale].ogLocale} />
{
  alternateEntries.length > 1 &&
    alternateEntries
      .filter(([l]) => l !== locale)
      .map(([l]) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)
}
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />

{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      {article.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
      )}
      <meta property="article:author" content={new URL("/about", site).href} />
      {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.handle} />
<meta name="twitter:creator" content={SITE.handle} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
