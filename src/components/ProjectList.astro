---
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

interface Props {
  projects: CollectionEntry<"projects">[]
}

const { projects } = Astro.props
---

<ul class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    projects.map(({ data }, i) => (
      <li class="rounded-md border shadow-xs">
        <a
          href={data.url}
          target="_blank"
          rel="noopener"
          class="relative block p-2 text-sm font-semibold"
        >
          <Image
            src={data.cover}
            alt={data.coverAlt}
            widths={[400, 800]}
            sizes="(min-width: 1024px) 370px, (min-width: 640px) 50vw, 100vw"
            loading={i < 3 ? "eager" : "lazy"}
            class="aspect-16/10 w-full rounded-sm object-cover object-top"
          />
          <span class="absolute bottom-1 left-1 rounded-md bg-white px-2">
            {data.name}
          </span>
        </a>
      </li>
    ))
  }
</ul>
